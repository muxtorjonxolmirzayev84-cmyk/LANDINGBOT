{
  "name": "pizza-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Pizza yetkazib berish: Telegram Bot + Mini App + Admin Panel",
  "main": "src/index.js",
  "scripts": {
    "setup": "npm install && npm install --prefix miniapp && npm install --prefix admin",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "miniapp": "npm run dev --prefix miniapp",
    "admin": "npm run dev --prefix admin",
    "all": "concurrently -n API,MINIAPP,ADMIN -c green,cyan,magenta \"npm:start\" \"npm:miniapp\" \"npm:admin\"",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "prisma": "^6.0.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
